{
  "manifest_version": 3,
  "name": "Scratchpad",
  "short_name": "Scratchpad",
  "version": "0.1.0",
  "description": "A markdown scratchpad on your new tab. No account, no network, data stays on your machine.",
  "homepage_url": "https://github.com/m4rcone/scratchpad-newtab",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "chrome_url_overrides": {
    "newtab": "newtab/index.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
